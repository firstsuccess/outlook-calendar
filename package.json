{
  "name": "monja-group-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/release.mjs",
    "test": "vitest run",
    "validate:manifest": "office-addin-manifest validate manifest.xml",
    "build:site": "npm run build && node scripts/build-site-worker.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.0.0",
    "@js-temporal/polyfill": "^0.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/office-js": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
